# ---------------------------------------------------------------------------
# Yogera — model provider. Copy to .env and fill in ONE of these blocks.
# The app picks whichever key it finds. No key at all = offline demo mode.
# ---------------------------------------------------------------------------

# Option A — OpenAI (simplest, best default quality)
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini

# Option B — Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5

# Option C — Google Gemini
# GEMINI_API_KEY=AIza...
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# Option D — your own fine-tuned Sunflower/Qwen served with vLLM or Ollama.
# Nothing leaves your machine; this is the end state of finetune/README.md.
# LLM_PROVIDER=compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=yogera-luganda
# LLM_API_KEY=not-needed-for-local

# Option E — OpenRouter / Together / Groq (any OpenAI-shaped gateway)
# LLM_PROVIDER=compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=900

# For finetune/ingest_hf.py when a dataset is gated (accept its terms first)
# HF_TOKEN=hf_...
