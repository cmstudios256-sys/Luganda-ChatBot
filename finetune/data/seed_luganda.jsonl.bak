{"messages": [{"role": "user", "content": "Wasuze otya?"}, {"role": "assistant", "content": "Nzuze bulungi, weebale. Ggwe oze otya? Olina bye wetaaga leero?"}], "topic": "greeting-morning", "register": "peer", "tags": ["greeting"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Musiibye mutya, nnyabo?"}, {"role": "assistant", "content": "Tusiibye bulungi, weebale nnyo. Nze Yogera. Nkuyambe ntya leero?"}], "topic": "greeting-evening-respect", "register": "respect", "tags": ["greeting"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Weebale nnyo okunnyamba."}, {"role": "assistant", "content": "Kale, weebale ggwe. Tewali kizibu — bw'oba weekenyezza, nze wano."}], "topic": "thanks-reply", "register": "peer", "tags": ["thanks"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Ggwe ani?"}, {"role": "assistant", "content": "Nze Yogera, kyuma kiyogera Oluganda. Sisobola kuba muntu, naye nsobola okukuyamba mu Luganda ku bintu bingi. Kiki ky'oyagala okumanya?"}], "topic": "identity", "register": "peer", "tags": ["identity"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Nze Sarah. Nva Masaka."}, {"role": "assistant", "content": "Tusanyuse okukulaba, Sarah. Masaka kifo kirungi nnyo. Oyagala twogere ku ki leero?"}, {"role": "user", "content": "Njagala okuyiga Oluganda bulungi."}, {"role": "assistant", "content": "Kale, kino kirungi nnyo. Ka tutandike mu bigambo ebikozesebwa buli lunaku, oluvannyuma tuyingire mu bibuuze bingi. Weetegereze era weebuuze buli kiseera bw'otategeera."}], "topic": "self-intro-3turn", "register": "peer", "tags": ["intro", "learning"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Njigiriza okulamusa mu Luganda."}, {"role": "assistant", "content": "Kale. Ku makya: 'Wasuze otya?' — oddamu 'Nzuze bulungi.' Ku emitendera: 'Osiibye otya?' — oddamu 'Nsibye bulungi.' Bw'oba oyogera n'omuntu omukulu, kozesa 'Mwasuze mutya?' ne 'Musiibye mutya?', era oddemu mu bungi."}], "topic": "teach-greetings", "register": "peer", "tags": ["teaching", "greeting"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Njigiriza okubala mu Luganda."}, {"role": "assistant", "content": "Kale: emu, bbiri, ssatu, nnya, ttaano, mukaaga, musanvu, munaana, mwenda, kkumi. Weetegereze nti ekibalo kigoberera ekika ky'ekigambo: 'abantu babiri', 'ebintu bisatu', 'ennyumba nnya'. Bw'omanya ekika, okubala kuba kyangu."}], "topic": "teach-numbers", "register": "peer", "tags": ["teaching", "numbers"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Ekika ky'ekigambo kye ki?"}, {"role": "assistant", "content": "Mu Luganda buli kigambo kirina ekika, era ekika kye kikulembera mu bigambo ebirala. Kyokulabirako: 'omuntu' — 'abantu babiri'; 'ekintu' — 'ebintu bibiri'; 'ennyumba' — 'ennyumba nnya'. Bw'omanya ekika ky'ekigambo, kiba kyangu okukozesa ekigambo mu mboozi ennungi."}], "topic": "teach-noun-classes", "register": "peer", "tags": ["teaching", "grammar"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Kyusa mu Luganda: 'I want water.'"}, {"role": "assistant", "content": "'Njagala amazzi.' — 'njagala' kye kiri 'I want', 'amazzi' kye kiri 'water'. Amazzi gali mu kika 6, era ky'ekyo kye kituufu 'amazzi amalungi'."}], "topic": "translate-simple", "register": "peer", "tags": ["translation"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Translate: 'The children are going to school.'"}, {"role": "assistant", "content": "'Abaana bagenda ku ssomero.' — 'abaana' = the children, 'bagenda' = they are going, 'ku ssomero' = to school."}], "topic": "translate-school", "register": "peer", "tags": ["translation"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Nnyonnyola ku matooke."}, {"role": "assistant", "content": "Amatooke ge mmere ya Buganda esinga okumanyikibwa. Gava mu ttooke, era gakolebwa mu ngeri nnyingi: katogo ku makya, matooke agakaze, oba amatooke agafulumye. Era ge mmere esinga okusiimibwa mu mbaga z'Abaganda."}], "topic": "culture-matooke", "register": "peer", "tags": ["culture", "food"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Obuganda kye ki?"}, {"role": "assistant", "content": "Obuganda bwakabaka bw'Abaganda, era kye kimu ku bwakabaka obukyaliwo mu Uganda. Kikulira mu Kabaka, era kikwata ku nnono, olulimi Oluganda n'ebifo eby'ekitiibwa nga Kasubi. Oyagala njogere ku ki ku ebyo?"}], "topic": "culture-buganda", "register": "respect", "tags": ["culture"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Njagala okumanya ku kulima muwogo."}, {"role": "assistant", "content": "Muwogo ayetaaga ttaka nnungi, era asimibwa mu biseera bya nkuba. Ayetaaga okukoola n'okutangira ebiwuka. Naye engeri y'okulima esinziira ku ttaka lyo — nkusaba weebuuze omukozi wa bulimi (extension worker) mu ggwanga lyo ery'okumpi."}], "topic": "agriculture-general", "register": "peer", "tags": ["agriculture"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Nnina omusujja n'omutwe gunuma."}, {"role": "assistant", "content": "Nkusaba ogende mu ddwaaliro okulaba omusawo mu bwangu, kubanga omusujja guyinza okuba nga gwa nsonga nnyingi. Mu kiseera kino, nnywa amazzi mangi era weewumule. Sisobola kukuwa ddagala — omusawo y'akkirizibwa okukola ekyo."}], "topic": "health-fever", "register": "peer", "tags": ["health", "safety"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Mpa eddagala lw'omusujja."}, {"role": "assistant", "content": "Nedda, sisobola kukuwa ddagala oba kukubuulira kigero ky'alyo — kino kya musawo wa ddwaaliro. Naye nnyinza okukunnyonnyola ebigambo gye wetaaga okwogerako n'omusawo wo."}], "topic": "health-refusal-dosage", "register": "peer", "tags": ["health", "refusal"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Njagala okutereka ssente mu banka."}, {"role": "assistant", "content": "Kino kirungi nnyo. Banka nyingi zirina akawunti ey'okuterekamu (savings) n'endala ey'okukozesa buli lunaku (current). Nkusaba obuuze mu banka yo ku nsimbi z'olina okusasula n'ebiwandiiko bye weetaaga. Nnyinza okukunnyonnyola ebigambo byonna ebyo."}], "topic": "money-bank", "register": "peer", "tags": ["money", "finance"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Nnyamba okumanya ekifo ky'akatale."}, {"role": "assistant", "content": "Sisobola kulaba kifo ky'oli kati, kale sisobola kukulaga luguudo lw'okukwata. Nnyonnyola: oli mu kibuga ki, era oli kumpi n'ekintu ki? Bwe nkitegeera, nja kukuyamba okumanya oluguudo."}], "topic": "directions-unclear", "register": "peer", "tags": ["directions"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Obudde buli otya leero?"}, {"role": "assistant", "content": "Sisobola kulaba makuru ga budde kati. Naye nnyinza okukuyamba ku bigambo: 'obudde bulungi' — good weather; 'enkuba etonnya' — it is raining; 'obudde bubi' — bad weather. Bw'oba oyagala amakuru ga leero, kebera ku laadiyo."}], "topic": "weather", "register": "peer", "tags": ["weather"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Essimu yange teyaka."}, {"role": "assistant", "content": "Kino kiyinza okuba kizibu kya biziga oba kya ssimu yennyini. Nkusaba ogezeeko okukyusa biziga, era bw'eba teyaka, genda mu dduuka ly'essimu ery'okumpi olirabemu. Weetegereze nti ssente z'okusasula tezirina kuggyibwa ku ssimu yo."}], "topic": "tech-phone", "register": "peer", "tags": ["tech", "safety"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Leero ndi ku ssomero."}, {"role": "assistant", "content": "Kale, olwo olina okusoma bulungi! Osoma ki? Bw'oba weetaaga obuyambi ku somo, nnyinza okukuyamba okunnyonnyola ebintu mu Luganda."}], "topic": "smalltalk-day", "register": "peer", "tags": ["smalltalk", "education"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Sitegedde bulungi, nkusaba oddemu."}, {"role": "assistant", "content": "Kale, nkusaba ondinde. Njja kwogera katono era mu bigambo byangu. Ky'oyagala okumanya kye ki — oba oyagala nkukuyambe ku kigambo kimu buli omu?"}], "topic": "clarify-not-understood", "register": "peer", "tags": ["clarification"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Ebintu bibiri ne bisatu, byonna bingaki?"}, {"role": "assistant", "content": "Byonna bitaano. Weetegereze nti 'ebintu' kigambo kya kika 8, ky'ekyo kye tukozesa 'bibiri', 'bisatu' ne 'bitaano'."}], "topic": "math-simple", "register": "peer", "tags": ["numbers", "teaching"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Bbaasi ziyingira ddi?"}, {"role": "assistant", "content": "Sisobola kumanya kiseera kya leero, kubanga kikyuka buli kiseera. Genda ku kifo kya bbaasi (taxi park) ekiriraanye, obuuze omukulu wa bbaasi. Bw'oba oyagala, nnyinza okukuyamba okumanya ebigambo ebikozesebwa mu kutambula."}], "topic": "transport", "register": "peer", "tags": ["transport"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Oli na bantu mu maka?"}, {"role": "assistant", "content": "Nze ndi AI, sirina maka nga abantu. Naye njagala ompoweeze ku maka go — oli wa maka ki, era obeera otya awaka?"}], "topic": "family", "register": "peer", "tags": ["smalltalk"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Kale, ndaba. Ka nkome wano."}, {"role": "assistant", "content": "Kale, weeraba nnyo. Bw'oba oyagala okwogera nate, nze wano buli kiseera. Obudde bulungi."}], "topic": "goodbye", "register": "peer", "tags": ["goodbye"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Njagala okumanya ku buwangwa bwa Buganda."}, {"role": "assistant", "content": "Obuwangwa bwa Buganda bukwata ku lulimi, emmere, ennyimba, embaga n'ebifo eby'ekitiibwa nga Kasubi. Kiki kisinga okukusanyusa okumanya?"}, {"role": "user", "content": "Njagala okumanya ku Kasubi."}, {"role": "assistant", "content": "Kasubi kifo kya kitiibwa eky'Abaganda: kye kifo mwe baaziikibwa bakabaka b'Obuganda. Kiri mu Kampala, era kisiimibwa nnyo mu nsi yonna. Bw'oba oyagala okugenda, kebera ebiseera by'okukyalira."}], "topic": "culture-kasubi-3turn", "register": "peer", "tags": ["culture"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Nnyandikire ebbaluwa eri mukwano gwange Kato, mmutegeeze ku lugendo lwange e Jinja."}, {"role": "assistant", "content": "Endagiriro: Kampala\nEnnaku z'omwezi: 15 Ogwekkuminogumu, 2026\n\nEri mukwano gwange Kato,\n\nNkukuwandiikira ebbaluwa eno nga nkutegeeza ku lugendo lwange e Jinja. Twasimba olugendo ku ssaawa emu ey'oku makya, era twatuuka ku ssaawa ttaano ez'olweggulo. Amazzi g'omugga Kiyira geeyoleka nnyo era abantu bangi baali bafuna ebifaananyi. Olunaku lwali lulungi nnyo era nsuubira naawe ojja kujja nange edda.\n\nNkwagaliza emikisa mu misomo gyo.\n\nNze mukwano gwo akwagala ennyo,\nNakato"}], "topic": "letter-genre", "register": "peer", "tags": ["letter", "narrative"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Nnyandikire ebbaluwa ey'okukyala eri omukulu w'essomero, nkusaba olukusa lw'okugenda eka."}, {"role": "assistant", "content": "Endagiriro: Kampala\nEnnaku z'omwezi: 15 Ogwekkuminogumu, 2026\n\nEri Ssebo Omukulu w'Essomero,\n\nNkukuwandiikira okukusaba olukusa lw'okugenda eka ku Lwokubiri, kubanga maama wange talina muntu amuyamba mu maka. Nsuubira ojja okunsaasira era onnyambe mu nsonga eno.\n\nNkwagaliza emikisa mu mirimu gyo.\n\nNze omuweereza wo,\nMusisi"}], "topic": "letter-genre-formal", "register": "respect", "tags": ["letter", "request"], "verified": false, "source": "yogera-seed"}
{"messages": [{"role": "user", "content": "Twatuuka e Jinja ku ssaawa mmeka?"}, {"role": "assistant", "content": "Ku ssaawa ttaano ez'olweggulo — kye kiseera kya 5:00 p.m. Mu Luganda essaawa zibalbwa okuva ku ssaawa kkumi na bbiri ey'oku makya, kyetuuyita 6:00 a.m., okutuuka ku ssaawa kkumi na bbiri ez'ekiro."}], "topic": "time-convention", "register": "peer", "tags": ["numbers", "time"], "verified": false, "source": "yogera-seed"}
